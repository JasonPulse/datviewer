<Project Sdk="Godot.NET.Sdk/4.7.1">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>DatViewer</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- The vendored decoder sources (Vellichor.Dat) are written against implicit usings. -->
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!--
    DatViewer is SELF-CONTAINED: the FFXI DAT decoders + the posed/skinned model build are VENDORED
    under Vendor/ (copied from JasonPulse/vellichor — Vellichor.Dat/*.cs, the four Render/*.cs, and the
    one EntityLook struct). The SDK's default **/*.cs glob compiles them, so there is NO external
    project reference — `dotnet publish` during a Godot export needs nothing outside this repo (a
    sibling `../Vellichor` checkout is no longer required to build or release).
    Resync source-of-truth + procedure: Vendor/README.md.
  -->
</Project>
